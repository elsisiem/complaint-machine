# Novita AI key. Drafts letters, venue text and contact suggestions. Required.
NOVITA_API_KEY=
# ActionLayer key. Sends the one approved email or tweet. Sending returns 503 without it.
ACTIONLAYER_API_KEY=
# Set to 1 to run the Flask debugger. Never on a public host.
FLASK_DEBUG=
# Port to listen on. Defaults to 5000.
PORT=
# Set to 1 behind a reverse proxy so the rate limit uses the real client IP.
TRUST_PROXY=
